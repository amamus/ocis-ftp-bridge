# Ignore files and directories that should not be included in the Docker image

# Git
.git
.gitignore

# Build artifacts
bin/
build/
dist/

# Dependency directories
vendor/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS-specific files
.DS_Store
Thumbs.db

# Test files
*_test.go
.test

# Documentation (can be added via separate stage if needed)
docs/
README.md
CHANGELOG.md
CONTRIBUTING.md

# Example configuration files
*.example
*.sample
# ...but ship the canonical example config in the image as a template
!config.yaml.example

# Logs
*.log
logs/

# Local build output (gitignored) and generated SBOM documents: keep the
# ~18 MB repo-root binary and the SBOM files out of the build context (QLT-007)
/ocis-ftp-bridge
/sbom.*.json

# Temporary files
tmp/
*~